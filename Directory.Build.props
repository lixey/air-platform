<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS9107;NU1902;NU1903</NoWarn>
    <RootNamespace Condition="$(MSBuildProjectName.StartsWith('Air.'))">$(MSBuildProjectName.Replace('Air.', 'Platform.'))</RootNamespace>
    <RootNamespace Condition="!$(MSBuildProjectName.StartsWith('Air.')) and $(MSBuildProjectName.EndsWith('.Api')) and '$(MSBuildProjectName)' != 'Demo.Api'">$(MSBuildProjectName.Substring(0, $([MSBuild]::Subtract($(MSBuildProjectName.Length), 4))))</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Api')) and '$(MSBuildProjectName)' != 'Demo.Api' and '$(MSBuildProjectName)' != 'Air.Api'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <Target Name="PlatformUsings" BeforeTargets="GenerateGlobalUsings" DependsOnTargets="IncludeTransitiveProjectReferences">
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Air.Data' or '@(ProjectReference->WithMetadataValue('Filename', 'Air.Data'))' != ''">
      <Using Include="Platform.Data" />
      <Using Include="Platform.Data.Contracts" />
      <Using Include="Platform.Data.Entities" />
      <Using Include="Platform.Data.Files" />
      <Using Include="Platform.Data.Querying" />
      <Using Include="Platform.Data.Tenancy" />
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Air.Data.Postgres' or '@(ProjectReference->WithMetadataValue('Filename', 'Air.Data.Postgres'))' != ''">
      <Using Include="Platform.Data.Postgres" />
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Air.Data.SqlServer' or '@(ProjectReference->WithMetadataValue('Filename', 'Air.Data.SqlServer'))' != ''">
      <Using Include="Platform.Data.SqlServer" />
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Air.Api' or '@(ProjectReference->WithMetadataValue('Filename', 'Air.Api'))' != ''">
      <Using Include="Platform.Api" />
      <Using Include="Platform.Api.Auth" />
      <Using Include="Platform.Api.Auth.Contracts" />
      <Using Include="Platform.Api.Contracts" />
      <Using Include="Platform.Api.Files" />
      <Using Include="Platform.Api.Host" />
      <Using Include="Platform.Api.Localization" />
      <Using Include="Platform.Api.Modules" />
      <Using Include="Platform.Api.Mutations" />
      <Using Include="Platform.Api.Resources" />
      <Using Include="Platform.Api.Security" />
      <Using Include="Platform.Api.Serialization" />
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Air.App' or '@(ProjectReference->WithMetadataValue('Filename', 'Air.App'))' != ''">
      <Using Include="Platform.App.Auth" />
      <Using Include="Platform.App.Changes" />
      <Using Include="Platform.App.Components.Contracts" />
      <Using Include="Platform.App.Contracts" />
      <Using Include="Platform.App.Files" />
      <Using Include="Platform.App.Files.Contracts" />
      <Using Include="Platform.App.Flow" />
      <Using Include="Platform.App.Form" />
      <Using Include="Platform.App.Form.Actions" />
      <Using Include="Platform.App.Form.Contracts" />
      <Using Include="Platform.App.Grid" />
      <Using Include="Platform.App.Grid.AddOns.Covers.Contracts" />
      <Using Include="Platform.App.Grid.Contracts" />
      <Using Include="Platform.App.Grid.Export" />
      <Using Include="Platform.App.Grid.Selection" />
      <Using Include="Platform.App.Host" />
      <Using Include="Platform.App.Metadata.Contracts" />
      <Using Include="Platform.App.Nav.Contracts" />
      <Using Include="Platform.App.Overlay" />
      <Using Include="Platform.App.Overlay.Contracts" />
      <Using Include="Platform.App.Panels" />
      <Using Include="Platform.App.Panels.Contracts" />
      <Using Include="Platform.App.Report" />
      <Using Include="Platform.App.Report.Contracts" />
      <Using Include="Platform.App.Screens" />
      <Using Include="Platform.App.Screens.Contracts" />
      <Using Include="Platform.App.TypeScript" />
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Air.Mcp' or '@(ProjectReference->WithMetadataValue('Filename', 'Air.Mcp'))' != ''">
      <Using Include="Platform.Mcp" />
      <Using Include="Platform.Mcp.Contracts" />
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Air.Agent' or '@(ProjectReference->WithMetadataValue('Filename', 'Air.Agent'))' != ''">
      <Using Include="Platform.Agent" />
      <Using Include="Platform.Agent.Contracts" />
      <Using Include="Platform.Agent.Providers" />
    </ItemGroup>
  </Target>
</Project>
