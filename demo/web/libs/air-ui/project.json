{
  "name": "air-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "libs/air-ui",
  "sourceRoot": "libs/air-ui/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "eslint libs/air-ui/src --config libs/air-ui/eslint.config.mjs --max-warnings 0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": ["tsc -p libs/air-ui/tsconfig.json --noEmit"],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config libs/air-ui/vite.config.mts"
      }
    }
  }
}
