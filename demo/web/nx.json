{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "neverConnectToCloud": true,
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "@nx/eslint:lint": {
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/eslint.config.mjs"]
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    }
  ],
  "generators": {
    "@nx/angular:application": {
      "inlineTemplate": true,
      "inlineStyle": true,
      "style": "css"
    },
    "@nx/angular:library": {
      "inlineTemplate": true,
      "style": "none"
    },
    "@nx/angular:component": {
      "type": "component",
      "inlineTemplate": true,
      "style": "none"
    },
    "@nx/angular:directive": {
      "type": "directive"
    }
  }
}
